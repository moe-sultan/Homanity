# Copy to .env.local and fill in what you have. Every key is optional:
# anything left blank falls back to the curated data and estimates.
# See docs/API_SETUP.md for how to get each one.

# Claude reads the renter's free-text description (src/lib/context/claudeExtractor.ts)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=

# Google Maps Platform: one key, with these APIs enabled on the project:
#   Routes API, Places API (New), Street View Static API, Geocoding API (import script only)
GOOGLE_MAPS_API_KEY=
# Switch individual Google features off without removing the key
# GOOGLE_ROUTES_DISABLED=1
# GOOGLE_STREETVIEW_DISABLED=1

# Map tiles need no key. Optionally point at another {z}/{x}/{y} tile server;
# the app falls back to CARTO, then OpenStreetMap, if tiles fail to load.
# NEXT_PUBLIC_MAP_TILES=
